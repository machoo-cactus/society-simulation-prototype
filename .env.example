STAGE0_ENVIRONMENT=development
STAGE0_CORS_ORIGINS=[]
STAGE0_DATA_DIRECTORY=data/runs
STAGE0_DATASET_DATABASE=stage0.sqlite3
# Optional real tool-agent provider. Leave unset for deterministic fake control.
# STAGE0_LLM_PROVIDER=openai-compatible
# STAGE0_LLM_BASE_URL=http://127.0.0.1:8080/v1
# STAGE0_LLM_MODEL=model-name
# STAGE0_LLM_API_KEY=
# STAGE0_LLM_RECORD_PATH=data/runs/model-turns.jsonl
# Use STAGE0_LLM_PROVIDER=replay with this path to run without live access.
# STAGE0_LLM_REPLAY_PATH=data/runs/model-turns.jsonl
STAGE0_LLM_TIMEOUT_SECONDS=30
STAGE0_LLM_MAX_OUTPUT_TOKENS=512
STAGE0_LLM_MAX_CONCURRENCY=4
